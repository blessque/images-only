{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justimages",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",

  // ONE Worker serves the static build AND the API. That is what lets it inline the
  // manifest into the HTML shell, collapsing the load-JS -> fetch-manifest -> layout
  // waterfall. See docs/architecture/OVERVIEW.md.
  //
  // `run_worker_first` is required: without it the asset server would answer `/` with the
  // un-inlined index.html and the Worker would never see the request.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "justimages",
      // Created 2026-08-09 in WEUR. Not a secret — an identifier, useless without auth.
      "database_id": "81788e80-11ed-4047-9faa-af219b719e52",

      // Applied with `wrangler d1 migrations apply`, which records each file in a
      // `d1_migrations` table and refuses to run it twice. A migration invoked with
      // `d1 execute --file` has NO memory of having run — and 0001 is not idempotent,
      // which corrupted local data exactly once before this was tightened.
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "justimages"
    }
  ],

  "observability": { "enabled": true }

  // Secrets are NOT here. Set them with `wrangler secret put`:
  //   ADMIN_PASSWORD_HASH   generated by `npm run hash-password`
  //   TOKEN_SECRET          any long random string; rotating it logs out live sessions
  // Local dev reads them from .dev.vars, which is gitignored.
}
