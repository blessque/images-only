{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justimages",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",

  // ONE Worker serves the static build AND the API. That is what lets it inline the
  // manifest into the HTML shell, collapsing the load-JS -> fetch-manifest -> layout
  // waterfall. See docs/architecture/OVERVIEW.md.
  //
  // `run_worker_first` is required: without it the asset server would answer `/` with the
  // un-inlined index.html and the Worker would never see the request.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "justimages",
      // Created 2026-08-09 in WEUR. Not a secret — an identifier, useless without auth.
      "database_id": "81788e80-11ed-4047-9faa-af219b719e52",

      // Applied with `wrangler d1 migrations apply`, which records each file in a
      // `d1_migrations` table and refuses to run it twice. A migration invoked with
      // `d1 execute --file` has NO memory of having run — and 0001 is not idempotent,
      // which corrupted local data exactly once before this was tightened.
      "migrations_dir": "migrations"
    }
  ],

  // Image bytes live in Workers KV, NOT R2 — R2 requires a credit card on the account and
  // KV does not. Free tier: 1GB stored, 100k reads/day, 1,000 writes/day. 200 photos at
  // four variants is ~300MB and 800 writes, so a full first upload fits inside one day.
  //
  // KV is EVENTUALLY CONSISTENT (up to ~60s worldwide), which is why Tile.tsx retries a
  // failed image before showing the broken mark.
  "kv_namespaces": [
    {
      "binding": "IMAGES",
      "id": "2bed4c9439cf4a6693b36678bfe6b72d",
      "preview_id": "3e7a51690ad14fd1a4f19f52fdaacd9b"
    }
  ],

  // R2 is BETTER when it is available — 10GB, no daily write cap, purpose-built for blobs.
  // `worker/storage.ts` still implements it and prefers it whenever the binding exists, so
  // switching back is exactly this:
  //
  //   1. enable R2 once in the Cloudflare dashboard (needs a card)
  //   2. npx wrangler r2 bucket create justimages
  //   3. uncomment the block below
  //   4. npm run export && npm run import   (carries the photographs across)
  //
  // No code changes. The R2-era build is also tagged `r2-reference`.
  //
  // "r2_buckets": [
  //   {
  //     "binding": "BUCKET",
  //     "bucket_name": "justimages"
  //   }
  // ],

  "observability": { "enabled": true }

  // Secrets are NOT here. Set them with `wrangler secret put`:
  //   ADMIN_PASSWORD_HASH   generated by `npm run hash-password`
  //   TOKEN_SECRET          any long random string; rotating it logs out live sessions
  // Local dev reads them from .dev.vars, which is gitignored.
}
