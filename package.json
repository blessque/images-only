{
  "name": "justimages",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "fixtures": "node scripts/make-fixtures.mjs",
    "verify": "node scripts/verify-grid.mjs",
    "worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "hash-password": "node --experimental-strip-types scripts/hash-password.ts",
    "verify:worker": "node scripts/verify-worker.mjs",
    "db:local": "wrangler d1 execute justimages --local --file=worker/schema.sql",
    "db:remote": "wrangler d1 execute justimages --remote --file=worker/schema.sql",
    "verify:admin": "node scripts/verify-admin.mjs",
    "verify:all": "npm run verify && npm run verify:worker && npm run verify:admin",
    "local": "npm run build && npm run db:local && wrangler dev",
    "local:reset": "wrangler d1 execute justimages --local --command \"DROP TABLE IF EXISTS images; DROP TABLE IF EXISTS settings; DROP TABLE IF EXISTS login_attempts;\" && npm run db:local",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
